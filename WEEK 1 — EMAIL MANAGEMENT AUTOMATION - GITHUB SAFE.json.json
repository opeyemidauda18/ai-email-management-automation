    {
      "parameters": {
        "jsCode": "const category = $('Map Gmail Label').first().json.category;\n\nconst labels = $input.all();\n\nconst labelMap = {\n  'Enquiry': 'Auto/Enquiry',\n  'Complaint': 'Auto/Complaint',\n  'Invoice/Billing': 'Auto/Invoice',\n  'Spam/Newsletter': 'Auto/Spam',\n  'Other': 'Auto/Other'\n};\n\nconst targetLabelName = labelMap[category] || 'Auto/Other';\n\nconst targetLabel = labels.find(\n  item => item.json.name === targetLabelName\n);\n\nif (!targetLabel) {\n  throw new Error(`Gmail label not found: ${targetLabelName}`);\n}\n\nreturn {\n  json: {\n    ...$('Map Gmail Label').first().json,\n    gmailLabel: targetLabelName,\n    gmailLabelId: targetLabel.json.id\n  }\n};"
      },
